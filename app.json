{
  "expo": {
    "name": "meadow",
    "slug": "meadow",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4E6C50"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "jsEngine": "jsc",
      "supportsTablet": true,
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "userInterfaceStyle": "automatic",
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#4E6C50"
      },
      "package": "com.anonymous.meadow"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/coming-soon/400Regular/ComingSoon_400Regular.ttf"
          ]
        }
      ]
    ]
  }
}
